# انسخ إلى .env و .env.local — لا ترفع القيم الحقيقية إلى Git

NEXT_PUBLIC_SUPABASE_URL=
# أحدهما يكفي (الجديد أو القديم)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# أحدهما يكفي — خادم فقط
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# اختياري (موجود أصلاً داخل روابط DB)
SUPABASE_PASSWORD=

# Pooler Transaction + ?pgbouncer=true
DATABASE_URL=
# Session/مباشر للـ migrations
DIRECT_URL=

# نص عشوائي طويل (32+ بايت). تغييره = كل الـ PINs تنكسر!
PIN_PEPPER=

# للـ seed: معرّف مستخدم المالك من Supabase Auth أو بريده
OWNER_USER_ID=
OWNER_EMAIL=
OWNER_FULL_NAME=المالك
# SEED_DEMO=0 لتعطيل بيانات التجربة
